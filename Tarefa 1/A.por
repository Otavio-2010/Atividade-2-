programa
{
	
	funcao inicio()
	{
		const inteiro hora_por_dia = 24
		inteiro ano = 365
		inteiro ano_horas

		ano_horas = ano * hora_por_dia

		escreva("Em um ano a ", ano_horas , " horas!")

		
	}
}
