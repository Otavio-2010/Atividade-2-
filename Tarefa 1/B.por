programa
{
	
	funcao inicio()
	{
		const inteiro hora_por_dia = 1440
		const inteiro decada = 10
		inteiro ano = 365
          inteiro dias_decadas
          
 	 	dias_decadas = (decada * ano) * hora_por_dia

 	 	escreva("Em uma década a ", dias_decadas , " minutos!")

		
	}
}
