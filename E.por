programa
{
	
	funcao inicio()
	{
		inteiro idade_segundos = 977000000 
		inteiro ano = 365
		inteiro idade
		const inteiro segundos_por_dia = 86400

		idade =  idade_segundos / (ano * segundos_por_dia) 
 
		
		escreva("Sua idade em segundos é ", idade_segundos ," convertido para anos é " , idade)
	}
}
