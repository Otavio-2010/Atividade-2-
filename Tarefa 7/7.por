programa
{
	
	funcao inicio()
	{
		inteiro n
		inteiro calculo

		escreva("Digite sua idade:")
		leia(n)

		calculo = n * (n + 1) / 2

		escreva("A soma de suas outras idades foram ", calculo )
	}
}
