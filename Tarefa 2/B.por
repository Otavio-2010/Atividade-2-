programa
{
	
	funcao inicio()
	{
		const real mercurio = 0.2408467
		inteiro idade = 977000000
		inteiro idade_mercurio 
          
          
		idade_mercurio =((((idade / 60) /60)/24)/365) / mercurio

		escreva("Sua idade em segundos é ", idade, ", em mercurio sua idade em anos ficaria : ", idade_mercurio)
	}
}
