programa
{
	
	funcao inicio()
	{
		cadeia chocolate

		escreva("Quantos chocolates você pretende comer ate final da sua vida?")
		leia(chocolate)

		escreva("Você pretende comer chocolates ", chocolate ,"!")
	}
}
