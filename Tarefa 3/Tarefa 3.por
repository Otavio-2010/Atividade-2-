programa
{
	
	funcao inicio()
	{
	     inteiro disciplinas = 6
	     inteiro tempo = 180
          inteiro divisao_de_tempo

          divisao_de_tempo = tempo / disciplinas

          escreva("Ele deveria divir o tempo entre as disciplinas em ", divisao_de_tempo , " minutos para cada disciplinas")
	     
	}
}
